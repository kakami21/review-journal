---
import PostCard from "./PostCard.astro";
import type { Post } from "../lib/posts/post";

interface Props {
  id: string;
  title: string;
  posts: Post[];
  layout?: "list" | "carousel" | "featured";
}
const { id, title, posts, layout = "list" } = Astro.props;
const horizontal = layout === "carousel";
---

<section aria-labelledby={id} class="space-y-4">
  <h2 id={id} class="text-xl font-bold">{title}</h2>
  {posts.length === 0 ? <p>公開された投稿はまだありません。</p> : (
    <ul class:list={[horizontal ? "carousel carousel-start w-full gap-5 pb-4" : "grid gap-5"]}>
      {posts.map(post => <li class:list={["min-w-0", horizontal && "carousel-item w-4/5 max-w-sm"]}>
        <div class="w-full"><PostCard post={post} featured={layout === "featured"} /></div>
      </li>)}
    </ul>
  )}
</section>
