---
import "../styles/global.css";

const siteName = "箱入レオのルーザー日記";
const copyrightYear = new Date().getFullYear();
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="release-version" content={import.meta.env.PUBLIC_RELEASE_TAG} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{siteName}</title>
  </head>
  <body>
    <header class="bg-amber-50 px-4 pt-10">
      <div class="mx-auto max-w-4xl">
        <h1 class="text-3xl font-bold sm:text-4xl">{siteName}</h1>
        <p class="mt-4">読んだ本、食べたもの、日々考えたこと。</p>
      </div>
    </header>
    <slot />
    <footer class="bg-amber-50 px-4 py-6">
      <p class="mx-auto max-w-4xl text-sm">© {copyrightYear} {siteName}</p>
    </footer>
  </body>
</html>
