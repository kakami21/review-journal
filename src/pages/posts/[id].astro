---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { readPublishedPosts } from "../../lib/cms/get-public-posts";

Astro.response.headers.set("Cache-Control", "no-store");

// 公開済み投稿だけを対象とし、認証済みの編集モードではEmDashが選んだ下書きを表示する。
const posts = await readPublishedPosts();
const post = posts.find((item) => item.id === Astro.params.id);

if (!post) {
  Astro.response.status = 404;
}
---

<SiteLayout>
  <main class="min-h-screen bg-amber-50 px-4 py-10">
    <div class="mx-auto max-w-2xl">
      <a href="/" class="link">ホームへ</a>

      {
        post ? (
          <article {...post.edit?.entry} class="mt-10">
            {(post.title || post.edit) && (
              <h1 {...post.edit?.title} data-placeholder={post.edit && "タイトルを入力"} class="mb-8 text-3xl font-bold leading-relaxed empty:before:content-[attr(data-placeholder)] empty:before:opacity-50">{post.title}</h1>
            )}
            <div {...post.edit?.body} data-placeholder={post.edit && "本文を入力"} class:list={["whitespace-pre-wrap wrap-break-word leading-8 empty:before:content-[attr(data-placeholder)] empty:before:opacity-50", post.edit && "min-h-8"]}>{post.body}</div>
          </article>
        ) : (
          <h1 class="mt-10 text-2xl font-bold">投稿が見つかりません</h1>
        )
      }
    </div>
  </main>
</SiteLayout>
