---
import { env } from "cloudflare:workers";
import SiteLayout from "../layouts/SiteLayout.astro";
import { getPublicPosts } from "../cms/public-posts";
import { PostListPage, type PostsResponse } from "../react-app/pages/PostListPage";

Astro.response.headers.set("Cache-Control", "no-store");

let initialData: PostsResponse | undefined;
let errorMessage = "";
try {
  initialData = await getPublicPosts(env as unknown as AstroBindings);
} catch (error) {
  console.error("Public posts failed", error);
  Astro.response.status = 500;
  errorMessage = "投稿の取得に失敗しました。時間をおいて再度お試しください。";
}
---

<SiteLayout>
  <PostListPage initialData={initialData} errorMessage={errorMessage} client:load />
</SiteLayout>
