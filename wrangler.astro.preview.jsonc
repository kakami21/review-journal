{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "account_id": "981a5c317da0eac85b328bc8dbcd9f6a",
  "name": "table-notes-preview",
  "workers_dev": true,
  "main": "./src/worker.ts",
  "compatibility_date": "2026-07-18",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "routes": [
    {
      "pattern": "preview.pakoirileo.nokishita.app",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "f9b3b197ea954dc9907d6dd09a6e3a28",
      "remote": true
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "table-notes-preview-media", "remote": true }],
  "browser": {
    "binding": "BROWSER",
    "remote": true
  },
  "vars": {
    "TABELOG_USERNAME": "pakoirileo"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/astro-preview/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "table-notes-preview-db",
      "database_id": "b033a198-5c81-4838-a955-2a6a7fbaefaa",
      "remote": true,
      "migrations_dir": "./migrations/emdash"
    }
  ],
  "observability": {
    "enabled": true
  },
  "secrets": {
    "required": [
      "POST_LIKE_SECRET"
    ]
  },
  "ratelimits": [
    {
      "name": "POST_LIKE_LIMITER",
      "namespace_id": "47001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
