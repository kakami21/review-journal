{
  "type": "module",
  "dependencies": {
    "@cloudflare/kumo": "2.6.0",
    "@emdash-cms/cloudflare": "^1.3.1",
    "emdash": "^1.3.1",
    "hono": "^4.12.30",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/cloudflare": "^14.4.2",
    "@astrojs/react": "^7.1.1",
    "@cloudflare/playwright": "^1.3.5",
    "@cloudflare/vite-plugin": "^1.45.1",
    "@cloudflare/workers-types": "^5.20260718.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "astro": "^7.4.2",
    "daisyui": "^5.6.18",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "scripts": {
    "dev": "CLOUDFLARE_ENV=development vite",
    "dev:worker": "CLOUDFLARE_ENV=development npm run build && wrangler dev --port 8787",
    "build": "npm run types:check && npm run typecheck && vite build",
    "preview": "CLOUDFLARE_ENV=development npm run build && vite preview",
    "deploy": "npm run build:production && wrangler deploy --config dist/astro-production/server/wrangler.json",
    "types": "wrangler types --env-interface CloudflareBindings --strict-vars false",
    "types:check": "wrangler types --env-interface CloudflareBindings --strict-vars false --check",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p tsconfig.worker.json",
    "dev:astro": "astro dev",
    "check:astro": "astro check --tsconfig astro/tsconfig.json",
    "build:astro": "npm run check:astro && astro build",
    "preview:astro": "npm run build:astro && astro preview",
    "deploy:astro": "npm run build:astro && wrangler deploy --config dist/astro/server/wrangler.json",
    "test": "vitest run",
    "test:cms": "node tests/cms.integration.mjs",
    "types:astro": "wrangler types --config wrangler.astro.jsonc --env-interface AstroBindings --include-runtime=false --strict-vars=false astro/cloudflare.d.ts",
    "build:production": "ASTRO_ENV=production npm run build:astro"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.30.1"
    },
    "zod": "4.6.7"
  }
}
