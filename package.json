{
  "type": "module",
  "dependencies": {
    "@cloudflare/kumo": "2.6.0",
    "@emdash-cms/cloudflare": "^1.3.1",
    "emdash": "^1.3.1",
    "hono": "^4.12.30",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/cloudflare": "^14.4.2",
    "@astrojs/react": "^7.1.1",
    "@cloudflare/playwright": "^1.3.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "astro": "^7.4.2",
    "daisyui": "^5.6.18",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "scripts": {
    "dev": "ASTRO_ENV=preview astro dev",
    "build": "npm run check && astro build",
    "preview": "ASTRO_ENV=preview astro preview",
    "deploy": "npm run deploy:production",
    "deploy:production": "npm run build:production && wrangler deploy --config dist/astro-production/server/wrangler.json",
    "deploy:preview": "npm run build:preview && wrangler deploy --config dist/astro-preview/server/wrangler.json",
    "check": "astro check",
    "types": "wrangler types --config wrangler.astro.preview.jsonc --env-interface AstroBindings --strict-vars=false cloudflare.d.ts",
    "test": "vitest run",
    "test:cms": "node tests/cms.integration.mjs",
    "build:preview": "ASTRO_ENV=preview npm run build",
    "build:production": "ASTRO_ENV=production npm run build"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.30.1"
    },
    "zod": "4.6.7"
  }
}
