{
  "type": "module",
  "dependencies": {
    "hono": "^4.12.30",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@cloudflare/playwright": "^1.3.5",
    "@cloudflare/vite-plugin": "^1.45.1",
    "@cloudflare/workers-types": "^5.20260718.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "daisyui": "^5.6.18",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "wrangler": "^4.112.0"
  },
  "scripts": {
    "dev": "CLOUDFLARE_ENV=development vite",
    "dev:worker": "CLOUDFLARE_ENV=development npm run build && wrangler dev --port 8787",
    "build": "npm run types:check && npm run typecheck && vite build",
    "preview": "CLOUDFLARE_ENV=development npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "types": "wrangler types --env-interface CloudflareBindings --strict-vars false",
    "types:check": "wrangler types --env-interface CloudflareBindings --strict-vars false --check",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p tsconfig.worker.json"
  }
}
