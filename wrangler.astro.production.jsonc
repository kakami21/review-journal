{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "account_id": "981a5c317da0eac85b328bc8dbcd9f6a",
  "name": "table-notes-production",
  "workers_dev": false,
  "main": "./src/worker.ts",
  "compatibility_date": "2026-07-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "pakoirileo.nokishita.app",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "d3419d12971c4d3ca72503b4d3674016",
      "remote": true
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "table-notes-production-media", "remote": true }],
  "browser": {
    "binding": "BROWSER",
    "remote": true
  },
  "vars": {
    "TABELOG_USERNAME": "pakoirileo"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/astro-production/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "table-notes-production-db",
      "database_id": "2c3e244f-ace3-4cc3-b70c-bca3f17513e4",
      "remote": true,
      "migrations_dir": "./migrations/emdash"
    }
  ],
  "observability": {
    "enabled": true
  },
  "secrets": {
    "required": [
      "POST_LIKE_SECRET"
    ]
  },
  "ratelimits": [
    {
      "name": "POST_LIKE_LIMITER",
      "namespace_id": "47002",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
