{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "account_id": "981a5c317da0eac85b328bc8dbcd9f6a",
  "name": "table-notes-astro-staging",
  "workers_dev": true,
  "main": "./src/worker/astro.ts",
  "compatibility_date": "2026-07-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [{ "pattern": "staging.pakoirileo.nokishita.app", "custom_domain": true }],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "f9b3b197ea954dc9907d6dd09a6e3a28"
    }
  ],
  "browser": {
    "binding": "BROWSER",
    "remote": true
  },
  "vars": {
    "TABELOG_USERNAME": "pakoirileo"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/astro/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "table-notes-staging",
      "database_id": "29d7ef4b-65b8-4a71-8820-3eaee6d9fe4a",
      "remote": true,
      "migrations_dir": "./astro/migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
