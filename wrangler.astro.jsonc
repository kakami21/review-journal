{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "account_id": "981a5c317da0eac85b328bc8dbcd9f6a",
  "name": "table-notes-astro-development",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-07-18",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [],
  "assets": { "binding": "ASSETS", "directory": "./dist/astro/client" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "table-notes-development",
      "database_id": "3554b63d-b513-432f-bed2-3a90f5159eb0",
      "remote": true,
      "migrations_dir": "./migrations"
    }
  ],
  "observability": { "enabled": true }
}
