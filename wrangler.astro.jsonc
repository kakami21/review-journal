{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "account_id": "981a5c317da0eac85b328bc8dbcd9f6a",
  "name": "table-notes-astro-development",
  "main": "./src/worker/astro.ts",
  "compatibility_date": "2026-07-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "f9b3b197ea954dc9907d6dd09a6e3a28"
    }
  ],
  "browser": {
    "binding": "BROWSER",
    "remote": true
  },
  "vars": {
    "TABELOG_USERNAME": "pakoirileo"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/astro/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "table-notes-development",
      "database_id": "3554b63d-b513-432f-bed2-3a90f5159eb0",
      "remote": true,
      "migrations_dir": "./astro/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "table-notes-media-development"
    }
  ],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "observability": {
    "enabled": true
  },
  "secrets": {
    "required": [
      "POST_LIKE_SECRET"
    ]
  },
  "ratelimits": [
    {
      "name": "POST_LIKE_LIMITER",
      "namespace_id": "47001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
