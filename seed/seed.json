{
  "version": "1",
  "settings": {
    "title": "箱入レオのルーザー日記",
    "timezone": "Asia/Tokyo"
  },
  "collections": [
    {
      "slug": "reviews",
      "label": "口コミ",
      "labelSingular": "口コミ",
      "titleField": "restaurant_name",
      "routable": false,
      "supports": [
        "drafts",
        "revisions",
        "scheduling"
      ],
      "fields": [
        {
          "slug": "source_id",
          "label": "食べログ口コミID",
          "type": "string",
          "required": true,
          "unique": true
        },
        {
          "slug": "source_url",
          "label": "食べログ口コミURL",
          "type": "url",
          "required": true
        },
        {
          "slug": "restaurant_name",
          "label": "店舗名",
          "type": "string",
          "required": true
        },
        {
          "slug": "restaurant_url",
          "label": "店舗URL",
          "type": "url",
          "required": true
        },
        {
          "slug": "title",
          "label": "タイトル",
          "type": "string",
          "required": false
        },
        {
          "slug": "body",
          "label": "本文",
          "type": "text",
          "required": false
        },
        {
          "slug": "review_month",
          "label": "訪問年月",
          "type": "string",
          "required": true
        },
        {
          "slug": "rating",
          "label": "評価",
          "type": "number",
          "required": true,
          "validation": {
            "min": 0,
            "max": 5
          }
        },
        {
          "slug": "like_count",
          "label": "いいね数",
          "type": "integer",
          "required": true
        },
        {
          "slug": "imported_at",
          "label": "初回取り込み日時",
          "type": "datetime",
          "required": true
        }
      ],
      "urlPattern": "/reviews#{slug}"
    },
    {
      "slug": "entries",
      "label": "手入力投稿",
      "labelSingular": "手入力投稿",
      "titleField": "title",
      "routable": false,
      "supports": [
        "drafts",
        "revisions",
        "scheduling"
      ],
      "urlPattern": "/reviews#manual-{id}",
      "fields": [
        {
          "slug": "kind",
          "label": "種類",
          "type": "select",
          "required": true,
          "validation": {
            "options": [
              "review",
              "note",
              "article"
            ]
          }
        },
        {
          "slug": "title",
          "label": "タイトル",
          "type": "string",
          "required": true
        },
        {
          "slug": "body",
          "label": "本文",
          "type": "text",
          "required": false
        },
        {
          "slug": "restaurant_name",
          "label": "店舗名（口コミ）",
          "type": "string",
          "required": false
        },
        {
          "slug": "restaurant_url",
          "label": "店舗URL（口コミ）",
          "type": "url",
          "required": false
        },
        {
          "slug": "review_month",
          "label": "訪問年月（YYYY-MM・口コミ）",
          "type": "string",
          "required": false
        },
        {
          "slug": "rating",
          "label": "評価（口コミ）",
          "type": "number",
          "required": false,
          "validation": {
            "min": 0,
            "max": 5
          }
        },
        {
          "slug": "photo",
          "label": "投稿の写真",
          "type": "image",
          "required": false
        }
      ]
    }
  ]
}
