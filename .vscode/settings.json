{
  "editor.fontFamily": "Menlo, monospace",
  "terminal.integrated.fontFamily": "Menlo, monospace",
  "editor.fontSize": 14,
  "editor.lineHeight": 24,
  "editor.fontLigatures": false,
  "editor.letterSpacing": 0.2,

  "editor.renderWhitespace": "selection",
  "editor.minimap.enabled": false,
  "editor.wordWrap": "on",
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "editor.rulers": [80],

  "files.encoding": "utf8",
  "files.autoGuessEncoding": false,
  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,

  "explorer.compactFolders": false,
  "githubPullRequests.defaultMergeMethod": "merge",
  "githubPullRequests.assignCreated": "${user}",
  "githubPullRequests.overrideDefaultBranch": "main",
  "githubPullRequests.createDefaultBaseBranch": "repositoryDefault",

  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": false,
    "scminput": false
  },

  "chat.includeApplyingInstructions": true,
  "github.copilot.chat.pullRequestDescriptionGeneration.instructions": [
    {
      "file": ".github/instructions/pull-request.instructions.md"
    }
  ],
	"github.copilot.chat.commitMessageGeneration.instructions": [
		{
      "file": ".github/instructions/commit-message.instructions.md"
		}
  ],
}
